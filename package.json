{
  "name": "agentdash",
  "version": "1.0.0",
  "description": "AI-powered agent management platform with LinkedIn and Office 365 integrations",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "node scripts/lint-and-fix.js --all",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:unit": "jest --testPathPattern='\\.test\\.(ts|tsx)$' --testPathIgnorePatterns='integration|e2e'",
    "test:integration": "jest --testPathPattern='integration'",
    "test:e2e": "playwright test",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:debug": "jest --detectOpenHandles --forceExit",
    "test:verbose": "jest --verbose",
    "test:silent": "jest --silent",
    "test:update-snapshots": "jest --updateSnapshot",
    "test:clear-cache": "jest --clearCache",
    "lighthouse:ci": "lhci autorun",
    "db:setup": "node scripts/setup-database.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "db:test": "node -e \"require('./scripts/setup-database.js').testDatabaseConnection()\"",
    "docker:build": "docker build -t agentdash .",
    "docker:run": "docker run -p 3000:3000 agentdash",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "vercel:deploy": "vercel --prod",
    "vercel:preview": "vercel",
    "vercel:dev": "vercel dev",
    "clean": "rm -rf .next node_modules/.cache",
    "clean:all": "rm -rf .next node_modules coverage test-results",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "postinstall": "husky install",
    "pki:generate": "node bin/pki-automate.js generate",
    "pki:renew": "node bin/pki-automate.js renew",
    "pki:status": "node bin/pki-automate.js status",
    "pki:monitor": "node bin/pki-automate.js monitor",
    "pki:test": "jest --testPathPattern=pki",
    "pki:test:coverage": "jest --testPathPattern=pki --coverage",
    "demo:pki": "node scripts/pki-demo.js",
    "demo:pki:test": "npm run dev & sleep 5 && npm run demo:pki",
    "sweep": "node bin/sweep-cli.js",
    "sweep:scan": "node bin/sweep-cli.js scan",
    "sweep:security": "node bin/sweep-cli.js scan --type security",
    "sweep:quality": "node bin/sweep-cli.js scan --type quality",
    "sweep:performance": "node bin/sweep-cli.js scan --type performance",
    "sweep:fix": "node bin/sweep-cli.js fix",
    "sweep:monitor": "node bin/sweep-cli.js monitor",
    "sweep:report": "node bin/sweep-cli.js report",
    "autotest": "node bin/autotester.js",
    "autotest:all": "node bin/autotester.js --all",
    "autotest:fix": "node bin/autotester.js --fix",
    "autotest:lint": "node bin/autotester.js --lint",
    "autotest:api": "node bin/autotester.js --api",
    "autotest:gui": "node bin/autotester.js --gui",
    "autotest:watch": "node bin/autotester.js --watch",
    "autotest:run": "node scripts/run-autotests.js",
    "autotest:pipeline": "node scripts/run-autotester.js --all",
    "autotest:self-loop": "node scripts/run-autotester.js --self-loop",
    "autotest:parallel": "node scripts/run-autotester.js --parallel --api --gui",
    "lint:watch": "node scripts/lint-and-fix.js --watch",
    "self-fix": "node scripts/self-fix-loop.js",
    "self-fix:watch": "node scripts/self-fix-loop.js --watch",
    "autotest:simple": "node scripts/simple-autotester.js --all",
    "autotest:simple:loop": "node scripts/simple-autotester.js --self-loop",
    "tls:quick": "node simple-server.js",
    "tls:start": "node server.js",
    "tls:setup": "node scripts/quick-start.js"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@next/font": "^14.0.0",
    "@supabase/supabase-js": "^2.38.0",
    "@clerk/nextjs": "^4.29.0",
    "lucide-react": "^0.294.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "framer-motion": "^10.16.0",
    "react-hook-form": "^7.47.0",
    "@hookform/resolvers": "^3.3.0",
    "zod": "^3.22.0",
    "date-fns": "^2.30.0",
    "recharts": "^2.8.0",
    "react-hot-toast": "^2.4.0",
    "axios": "^1.6.0",
    "swr": "^2.2.0",
    "zustand": "^4.4.0",
    "immer": "^10.0.0",
    "nanoid": "^5.0.0",
    "uuid": "^9.0.0",
    "commander": "^11.1.0",
    "pkcs11js": "^1.2.0",
    "prom-client": "^15.0.0",
    "ioredis": "^5.3.0",
    "winston": "^3.11.0",
    "node-forge": "^1.3.1",
    "@aws-sdk/client-acm": "^3.450.0",
    "@aws-sdk/client-kms": "^3.450.0",
    "acme-client": "^4.2.4",
    "nodemailer": "^6.9.0",
    "cron": "^3.1.0",
    "helmet": "^7.1.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.1.0",
    "ocsp": "^1.2.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "csv-parser": "^3.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "commander": "^11.0.0",
    "js-yaml": "^4.1.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "inquirer": "^12.11.0",
    "chokidar": "^3.5.3",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/multer": "^1.4.0",
    "@types/pdf-parse": "^1.1.0",
    "@types/express": "^4.17.0",
    "typescript": "^5.2.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.52.0",
    "eslint-config-next": "^14.0.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/user-event": "^14.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@playwright/test": "^1.40.0",
    "@lhci/cli": "^0.12.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "snyk": "^1.1240.0",
    "license-checker": "^25.0.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^2.0.0",
    "nock": "^13.4.0"
  },
  "bin": {
    "pki-automate": "./bin/pki-automate.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reconsumeralization/AgentDash.git"
  },
  "keywords": [
    "ai",
    "agent",
    "management",
    "linkedin",
    "office365",
    "automation",
    "nextjs",
    "typescript",
    "react"
  ],
  "author": "AgentDash Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/reconsumeralization/AgentDash/issues"
  },
  "homepage": "https://github.com/reconsumeralization/AgentDash#readme",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "lib/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}