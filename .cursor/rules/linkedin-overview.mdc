## 🔧 Core Integration Patterns

### Error Handling Strategy
```typescript
class LinkedInIntegration {
  async safeApiCall<T>(
    operation: () => Promise<T>,
    context: string
  ): Promise<T> {
    try {
      return await operation()
    } catch (error) {
      if (error instanceof LinkedInApiException) {
        await this.handleLinkedInError(error, context)
      }
      throw error
    }
  }

  private async handleLinkedInError(error: LinkedInApiException, context: string): Promise<void> {
    console.error(`LinkedIn API Error in ${context}:`, error.message)

    // Log to monitoring system
    await this.logError({
      service: 'linkedin',
      context,
      error: error.message,
      status: error.status,
      timestamp: new Date()
    })

    // Handle specific error types
    if (error.status === 401) {
      await this.handleTokenRefresh()
    } else if (error.status === 429) {
      await this.handleRateLimit(error)
    } else if (error.status >= 500) {
      await this.handleServerError(error)
    }
  }
}
```

### Rate Limit Management
```typescript
class RateLimitManager {
  private requests = new Map<string, number[]>()

  async throttle(endpoint: string): Promise<void> {
    const now = Date.now()
    const windowStart = now - 60000 // 1 minute window

    // Clean old requests
    const endpointRequests = this.requests.get(endpoint) || []
    const recentRequests = endpointRequests.filter(time => time > windowStart)

    // Check limits
    if (recentRequests.length >= 100) { // 100 requests per minute
      const oldestRequest = Math.min(...recentRequests)
      const waitTime = 60000 - (now - oldestRequest)
      await new Promise(resolve => setTimeout(resolve, waitTime))
    }

    // Record this request
    recentRequests.push(now)
    this.requests.set(endpoint, recentRequests)
  }
}
```

### Configuration Management
```typescript
interface LinkedInIntegrationConfig {
  environment: 'sandbox' | 'production'
  credentials: {
    clientId: string
    clientSecret: string
    redirectUri: string
  }
  features: {
    marketing: boolean
    sales: boolean
    talent: boolean
    learning: boolean
    compliance: boolean
  }
  limits: {
    maxRetries: number
    requestTimeout: number
    rateLimitBuffer: number
  }
}

class ConfigValidator {
  static validate(config: LinkedInIntegrationConfig): string[] {
    const errors: string[] = []

    if (!config.credentials.clientId) {
      errors.push('Client ID is required')
    }

    if (!config.credentials.clientSecret) {
      errors.push('Client Secret is required')
    }

    if (!config.credentials.redirectUri) {
      errors.push('Redirect URI is required')
    }

    const hasFeatures = Object.values(config.features).some(enabled => enabled)
    if (!hasFeatures) {
      errors.push('At least one business line feature must be enabled')
    }

    return errors
  }
}
```

## 🎯 Common Integration Scenarios

### 1. User Authentication Flow
```typescript
class LinkedInAuthService {
  async authenticateUser(): Promise<UserProfile> {
    // Step 1: Redirect to LinkedIn for authorization
    const authUrl = this.buildAuthUrl(['profile', 'email'])
    window.location.href = authUrl

    // Step 2: Handle callback (in callback page)
    const { code } = this.parseCallbackParams()
    const tokens = await this.exchangeCodeForTokens(code)

    // Step 3: Get user profile
    const profile = await this.getUserProfile(tokens.access_token)

    return profile
  }

  private buildAuthUrl(scopes: string[]): string {
    const params = new URLSearchParams({
      response_type: 'code',
      client_id: this.clientId,
      redirect_uri: this.redirectUri,
      scope: scopes.join(' '),
      state: this.generateState()
    })

    return `https://www.linkedin.com/oauth/v2/authorization?${params}`
  }
}
```

### 2. Campaign Management System
```typescript
class CampaignManager {
  async createAndMonitorCampaign(campaignData: CampaignInput): Promise<Campaign> {
    // Create campaign
    const campaign = await this.linkedinClient.marketing.createCampaign(campaignData)

    // Set up monitoring
    await this.setupCampaignMonitoring(campaign.id)

    // Schedule performance reports
    await this.schedulePerformanceReports(campaign.id)

    return campaign
  }

  private async setupCampaignMonitoring(campaignId: string): Promise<void> {
    // Set up webhooks for campaign updates
    await this.linkedinClient.webhooks.create({
      resource: `/adCampaigns/${campaignId}`,
      events: ['CAMPAIGN_UPDATED', 'CAMPAIGN_PAUSED'],
      callbackUrl: `${this.baseUrl}/webhooks/campaign-updates`
    })
  }
}
```

### 3. Lead Generation Pipeline
```typescript
class LeadGenerationPipeline {
  async processLeadGenerationForm(formId: string): Promise<void> {
    // Get new submissions
    const submissions = await this.linkedinClient.marketing.getFormSubmissions(formId)

    for (const submission of submissions) {
      await this.processSubmission(submission)
    }
  }

  private async processSubmission(submission: LeadSubmission): Promise<void> {
    // Validate submission
    const validationResult = await this.validateSubmission(submission)

    if (!validationResult.isValid) {
      await this.handleInvalidSubmission(submission, validationResult.errors)
      return
    }

    // Enrich lead data
    const enrichedLead = await this.enrichLeadData(submission)

    // Add to CRM
    await this.crmClient.createLead(enrichedLead)

    // Send welcome email
    await this.emailService.sendWelcomeEmail(enrichedLead.email)
  }
}
```

### 4. Job Posting Integration
```typescript
class JobPostingIntegration {
  async syncJobPosting(internalJob: InternalJobPosting): Promise<LinkedInJob> {
    // Transform internal job to LinkedIn format
    const linkedinJob = this.transformJobForLinkedIn(internalJob)

    // Create job posting
    const createdJob = await this.linkedinClient.talent.createJob(linkedinJob)

    // Set up application tracking
    await this.setupApplicationTracking(createdJob.id)

    // Update internal system with LinkedIn job ID
    await this.internalApi.updateJob(internalJob.id, {
      linkedinJobId: createdJob.id
    })

    return createdJob
  }

  private async setupApplicationTracking(jobId: string): Promise<void> {
    // Webhook for new applications
    await this.linkedinClient.webhooks.create({
      resource: `/jobs/${jobId}/applications`,
      events: ['APPLICATION_SUBMITTED'],
      callbackUrl: `${this.baseUrl}/webhooks/job-applications`
    })
  }
}
```

## 🔒 Security Best Practices

### Token Management
```typescript
class TokenManager {
  private tokens: Map<string, TokenInfo> = new Map()

  async getValidToken(userId: string): Promise<string> {
    const tokenInfo = this.tokens.get(userId)

    if (!tokenInfo) {
      throw new Error('No token found for user')
    }

    if (this.isTokenExpired(tokenInfo)) {
      const refreshed = await this.refreshToken(tokenInfo.refreshToken)
      this.tokens.set(userId, refreshed)
      return refreshed.accessToken
    }

    return tokenInfo.accessToken
  }

  private isTokenExpired(tokenInfo: TokenInfo): boolean {
    const now = Date.now()
    const expiresAt = tokenInfo.createdAt + (tokenInfo.expiresIn * 1000)
    const buffer = 5 * 60 * 1000 // 5 minutes buffer
    return now >= (expiresAt - buffer)
  }

  private async refreshToken(refreshToken: string): Promise<TokenInfo> {
    const response = await fetch('https://www.linkedin.com/oauth/v2/accessToken', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({
        grant_type: 'refresh_token',
        refresh_token: refreshToken,
        client_id: this.clientId,
        client_secret: this.clientSecret
      })
    })

    const data = await response.json()
    return {
      accessToken: data.access_token,
      refreshToken: data.refresh_token || refreshToken,
      expiresIn: data.expires_in,
      createdAt: Date.now()
    }
  }
}
```

