## 📈 Monitoring & Analytics

### Integration Health Dashboard
```typescript
class IntegrationDashboard {
  async getHealthMetrics(): Promise<HealthMetrics> {
    return {
      apiCalls: await this.getApiCallMetrics(),
      errorRates: await this.getErrorRateMetrics(),
      responseTimes: await this.getResponseTimeMetrics(),
      businessMetrics: await this.getBusinessMetrics()
    }
  }

  private async getApiCallMetrics(): Promise<ApiCallMetrics> {
    // Aggregate API call data from logs
    const metrics = await this.metricsStore.getMetrics('linkedin_api_calls', {
      timeframe: '24h',
      groupBy: 'endpoint'
    })

    return {
      totalCalls: metrics.total,
      callsPerEndpoint: metrics.byEndpoint,
      callsPerHour: metrics.byHour
    }
  }

  private async getBusinessMetrics(): Promise<BusinessMetrics> {
    return {
      campaignsCreated: await this.getCampaignCreationCount(),
      leadsGenerated: await this.getLeadGenerationCount(),
      jobsPosted: await this.getJobPostingCount(),
      applicationsReceived: await this.getApplicationCount()
    }
  }
}
```

### Alert System
```typescript
class AlertManager {
  async checkHealth(): Promise<void> {
    const metrics = await this.dashboard.getHealthMetrics()

    // Check error rate threshold
    if (metrics.errorRates.overall > 0.05) { // 5% error rate
      await this.sendAlert('High Error Rate', `Error rate is ${metrics.errorRates.overall * 100}%`)
    }

    // Check response time threshold
    if (metrics.responseTimes.average > 5000) { // 5 seconds
      await this.sendAlert('Slow Response Times', `Average response time is ${metrics.responseTimes.average}ms`)
    }

    // Check rate limit hits
    if (metrics.apiCalls.rateLimitHits > 10) {
      await this.sendAlert('Rate Limit Issues', `Hit rate limits ${metrics.apiCalls.rateLimitHits} times`)
    }
  }

  private async sendAlert(title: string, message: string): Promise<void> {
    // Send to monitoring system (DataDog, New Relic, etc.)
    await this.monitoringClient.sendAlert({
      title,
      message,
      severity: 'warning',
      tags: ['linkedin', 'api', 'integration']
    })
  }
}
```

