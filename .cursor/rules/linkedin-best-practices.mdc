### Pagination Handling
```typescript
interface PaginatedResponse<T> {
  elements: T[]
  paging: {
    count: number
    start: number
    total: number
    links?: string[]
  }
}

class PaginatedRequestHandler {
  async getAllPages<T>(
    endpoint: string,
    params: Record<string, any> = {},
    pageSize: number = 50
  ): Promise<T[]> {
    const allResults: T[] = []
    let start = 0
    let hasMore = true

    while (hasMore) {
      const queryParams = new URLSearchParams({
        ...params,
        count: pageSize.toString(),
        start: start.toString()
      })

      const response: PaginatedResponse<T> = await this.apiRequest(
        `${endpoint}?${queryParams}`
      )

      allResults.push(...response.elements)

      if (response.elements.length < pageSize) {
        hasMore = false
      } else {
        start += pageSize
      }

      // Respect rate limits
      await this.rateLimitDelay()
    }

    return allResults
  }

  private async rateLimitDelay(): Promise<void> {
    // Implement rate limit respecting delay
    await new Promise(resolve => setTimeout(resolve, 100))
  }
}
```

## Configuration Management

### Environment-Based Configuration
```typescript
interface LinkedInConfig {
  environment: 'sandbox' | 'production'
  clientId: string
  clientSecret: string
  redirectUri: string
  scopes: string[]
  rateLimits: {
    requestsPerMinute: number
    requestsPerHour: number
  }
  timeouts: {
    connection: number
    request: number
  }
  retryPolicy: {
    maxRetries: number
    backoffMultiplier: number
    maxBackoffTime: number
  }
}

class ConfigManager {
  private static configs: Record<string, LinkedInConfig> = {
    sandbox: {
      environment: 'sandbox',
      clientId: process.env.LINKEDIN_SANDBOX_CLIENT_ID!,
      clientSecret: process.env.LINKEDIN_SANDBOX_CLIENT_SECRET!,
      redirectUri: process.env.LINKEDIN_SANDBOX_REDIRECT_URI!,
      scopes: ['r_liteprofile', 'r_emailaddress', 'w_member_social'],
      rateLimits: {
        requestsPerMinute: 10,
        requestsPerHour: 100
      },
      timeouts: {
        connection: 5000,
        request: 30000
      },
      retryPolicy: {
        maxRetries: 3,
        backoffMultiplier: 2,
        maxBackoffTime: 30000
      }
    },
    production: {
      environment: 'production',
      clientId: process.env.LINKEDIN_CLIENT_ID!,
      clientSecret: process.env.LINKEDIN_CLIENT_SECRET!,
      redirectUri: process.env.LINKEDIN_REDIRECT_URI!,
      scopes: ['r_liteprofile', 'r_emailaddress', 'w_member_social', 'rw_ads'],
      rateLimits: {
        requestsPerMinute: 100,
        requestsPerHour: 1000
      },
      timeouts: {
        connection: 10000,
        request: 60000
      },
      retryPolicy: {
        maxRetries: 5,
        backoffMultiplier: 1.5,
        maxBackoffTime: 60000
      }
    }
  }

  static getConfig(environment: 'sandbox' | 'production' = 'sandbox'): LinkedInConfig {
    const config = this.configs[environment]
    if (!config) {
      throw new Error(`Configuration not found for environment: ${environment}`)
    }
    return config
  }

  static validateConfig(config: LinkedInConfig): string[] {
    const errors: string[] = []

    if (!config.clientId) errors.push('Client ID is required')
    if (!config.clientSecret) errors.push('Client Secret is required')
    if (!config.redirectUri) errors.push('Redirect URI is required')
    if (!config.scopes.length) errors.push('At least one scope is required')

    return errors
  }
}
