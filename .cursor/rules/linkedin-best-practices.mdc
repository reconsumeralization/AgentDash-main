# LinkedIn API Development Best Practices

## Architecture Patterns

### Client Factory Pattern
```typescript
interface LinkedInClientConfig {
  clientId: string
  clientSecret: string
  redirectUri: string
  scopes: string[]
  businessLines: BusinessLine[]
}

type BusinessLine = 'marketing' | 'sales' | 'talent' | 'learning' | 'compliance'

class LinkedInClientFactory {
  static create(config: LinkedInClientConfig): LinkedInUnifiedClient {
    // Validate configuration
    this.validateConfig(config)

    // Create OAuth client
    const oauthClient = new LinkedInOAuthClient({
      clientId: config.clientId,
      clientSecret: config.clientSecret,
      redirectUri: config.redirectUri
    })

    // Create business line clients
    const clients: Partial<Record<BusinessLine, any>> = {}

    if (config.businessLines.includes('marketing')) {
      clients.marketing = new MarketingCampaignManager(oauthClient)
    }

    if (config.businessLines.includes('sales')) {
      clients.sales = new SalesNavigatorClient(oauthClient)
    }

    if (config.businessLines.includes('talent')) {
      clients.talent = new JobPostingManager(oauthClient)
    }

    return new LinkedInUnifiedClient(oauthClient, clients)
  }

  private static validateConfig(config: LinkedInClientConfig): void {
    if (!config.clientId) {
      throw new Error('Client ID is required')
    }

    if (!config.clientSecret) {
      throw new Error('Client Secret is required')
    }

    if (!config.scopes.length) {
      throw new Error('At least one scope is required')
    }

    // Validate scope compatibility
    const invalidScopes = this.getInvalidScopeCombinations(config.scopes)
    if (invalidScopes.length) {
      throw new Error(`Invalid scope combinations: ${invalidScopes.join(', ')}`)
    }
  }

  private static getInvalidScopeCombinations(scopes: string[]): string[] {
    // Implement scope validation logic
    return []
  }
}
```

### Repository Pattern for Data Management
```typescript
interface LinkedInEntity {
  id: string
  createdAt: string
  updatedAt: string
}

interface Repository<T extends LinkedInEntity> {
  findById(id: string): Promise<T | null>
  findAll(filter?: Partial<T>): Promise<T[]>
  create(entity: Omit<T, 'id' | 'createdAt' | 'updatedAt'>): Promise<T>
  update(id: string, updates: Partial<T>): Promise<T>
  delete(id: string): Promise<void>
}

class LinkedInRepository<T extends LinkedInEntity> implements Repository<T> {
  constructor(
    private client: LinkedInApiClient,
    private endpoint: string
  ) {}

  async findById(id: string): Promise<T | null> {
    try {
      return await this.client.get(`${this.endpoint}/${id}`)
    } catch (error) {
      if (error.status === 404) return null
      throw error
    }
  }

  async findAll(filter?: Partial<T>): Promise<T[]> {
    const queryParams = filter ? new URLSearchParams(filter as any) : ''
    return this.client.get(`${this.endpoint}?${queryParams}`)
  }

  async create(entity: Omit<T, 'id' | 'createdAt' | 'updatedAt'>): Promise<T> {
    return this.client.post(this.endpoint, entity)
  }

  async update(id: string, updates: Partial<T>): Promise<T> {
    return this.client.put(`${this.endpoint}/${id}`, updates)
  }

  async delete(id: string): Promise<void> {
    await this.client.delete(`${this.endpoint}/${id}`)
  }
}

// Usage example
class CampaignRepository extends LinkedInRepository<MarketingCampaign> {
  constructor(client: LinkedInApiClient) {
    super(client, '/v2/adCampaignsV2')
  }

  async findActiveCampaigns(): Promise<MarketingCampaign[]> {
    return this.findAll({ status: 'ACTIVE' })
  }

  async findByAccount(accountId: string): Promise<MarketingCampaign[]> {
    return this.client.get(`/v2/adCampaignsV2?q=search&account=urn:li:sponsoredAccount:${accountId}`)
  }
}
```

## Data Transformation Patterns

### Request/Response Transformers
```typescript
interface Transformer<TInput, TOutput> {
  transform(input: TInput): TOutput
  transformMany(inputs: TInput[]): TOutput[]
}

class LinkedInDataTransformer {
  // Transform internal models to LinkedIn API format
  static toLinkedInCampaign(internal: InternalCampaign): MarketingCampaign {
    return {
      name: internal.title,
      account: `urn:li:sponsoredAccount:${internal.accountId}`,
      campaignGroup: `urn:li:sponsoredCampaignGroup:${internal.groupId}`,
      status: internal.isActive ? 'ACTIVE' : 'PAUSED',
      objectiveType: this.mapObjectiveType(internal.objective),
      budget: {
        amount: internal.dailyBudget,
        currencyCode: internal.currency,
        type: 'DAILY'
      },
      targetAudience: {
        locations: internal.targetLocations,
        industries: internal.targetIndustries,
        jobTitles: internal.targetJobTitles,
        seniorities: internal.targetSeniorities
      }
    }
  }

  // Transform LinkedIn API responses to internal models
  static fromLinkedInCampaign(api: MarketingCampaign): InternalCampaign {
    return {
      id: this.extractId(api.id!),
      title: api.name,
      accountId: this.extractId(api.account),
      groupId: this.extractId(api.campaignGroup),
      isActive: api.status === 'ACTIVE',
      objective: this.mapObjectiveTypeReverse(api.objectiveType),
      dailyBudget: api.budget.amount,
      currency: api.budget.currencyCode,
      targetLocations: api.targetAudience.locations,
      targetIndustries: api.targetAudience.industries,
      targetJobTitles: api.targetAudience.jobTitles,
      targetSeniorities: api.targetAudience.seniorities,
      createdAt: new Date(),
      updatedAt: new Date()
    }
  }

  private static extractId(urn: string): string {
    return urn.split(':').pop()!
  }

  private static mapObjectiveType(internal: string): MarketingCampaign['objectiveType'] {
    const mapping: Record<string, MarketingCampaign['objectiveType']> = {
      'brand_awareness': 'BRAND_AWARENESS',
      'consideration': 'CONSIDERATION',
      'lead_generation': 'LEAD_GENERATION',
      'website_visits': 'WEBSITE_VISITS'
    }
    return mapping[internal] || 'BRAND_AWARENESS'
  }

  private static mapObjectiveTypeReverse(api: MarketingCampaign['objectiveType']): string {
    const mapping: Record<MarketingCampaign['objectiveType'], string> = {
      'BRAND_AWARENESS': 'brand_awareness',
      'CONSIDERATION': 'consideration',
      'LEAD_GENERATION': 'lead_generation',
      'WEBSITE_VISITS': 'website_visits'
    }
    return mapping[api] || 'brand_awareness'
  }
}
