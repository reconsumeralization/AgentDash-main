## Testing Patterns

### Mock Client for Testing
```typescript
class LinkedInMockClient implements LinkedInApiClient {
  private mockResponses: Map<string, any> = new Map()

  setMockResponse(endpoint: string, response: any): void {
    this.mockResponses.set(endpoint, response)
  }

  async get(endpoint: string): Promise<any> {
    const response = this.mockResponses.get(endpoint)
    if (!response) {
      throw new Error(`Mock response not found for: ${endpoint}`)
    }
    return response
  }

  async post(endpoint: string, data: any): Promise<any> {
    // Simulate API delay
    await new Promise(resolve => setTimeout(resolve, 100))
    return { id: 'mock-id-' + Date.now(), ...data }
  }

  async put(endpoint: string, data: any): Promise<any> {
    return { ...data, updatedAt: new Date().toISOString() }
  }

  async delete(endpoint: string): Promise<void> {
    // Simulate successful deletion
    return
  }
}

// Usage in tests
describe('MarketingCampaignManager', () => {
  let mockClient: LinkedInMockClient
  let campaignManager: MarketingCampaignManager

  beforeEach(() => {
    mockClient = new LinkedInMockClient()
    campaignManager = new MarketingCampaignManager(mockClient, 'test-account')
  })

  it('should create campaign successfully', async () => {
    const campaign = { name: 'Test Campaign', objectiveType: 'BRAND_AWARENESS' }

    mockClient.setMockResponse('/v2/adCampaignsV2', {
      id: 'urn:li:sponsoredCampaign:123',
      ...campaign,
      status: 'DRAFT'
    })

    const result = await campaignManager.createCampaign(campaign)
    expect(result.id).toBe('urn:li:sponsoredCampaign:123')
    expect(result.name).toBe('Test Campaign')
  })
})
```

