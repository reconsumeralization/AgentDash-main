## Monitoring & Observability

### Metrics Collection
```typescript
interface LinkedInMetrics {
  totalRequests: number
  successfulRequests: number
  failedRequests: number
  rateLimitHits: number
  averageResponseTime: number
  requestsPerEndpoint: Record<string, number>
  errorsPerEndpoint: Record<string, number>
}

class LinkedInMetricsCollector {
  private metrics: LinkedInMetrics = {
    totalRequests: 0,
    successfulRequests: 0,
    failedRequests: 0,
    rateLimitHits: 0,
    averageResponseTime: 0,
    requestsPerEndpoint: {},
    errorsPerEndpoint: {}
  }

  recordRequest(endpoint: string, startTime: number, success: boolean, error?: any): void {
    this.metrics.totalRequests++

    if (success) {
      this.metrics.successfulRequests++
    } else {
      this.metrics.failedRequests++
      this.recordError(endpoint, error)
    }

    this.updateResponseTime(Date.now() - startTime)
    this.updateEndpointMetrics(endpoint, success)
  }

  private recordError(endpoint: string, error: any): void {
    if (error?.status === 429) {
      this.metrics.rateLimitHits++
    }

    const endpointKey = this.getEndpointKey(endpoint)
    this.metrics.errorsPerEndpoint[endpointKey] =
      (this.metrics.errorsPerEndpoint[endpointKey] || 0) + 1
  }

  private updateResponseTime(responseTime: number): void {
    const alpha = 0.1 // Exponential moving average
    this.metrics.averageResponseTime =
      (1 - alpha) * this.metrics.averageResponseTime + alpha * responseTime
  }

  private updateEndpointMetrics(endpoint: string, success: boolean): void {
    const endpointKey = this.getEndpointKey(endpoint)
    this.metrics.requestsPerEndpoint[endpointKey] =
      (this.metrics.requestsPerEndpoint[endpointKey] || 0) + 1
  }

  private getEndpointKey(endpoint: string): string {
    // Group similar endpoints
    if (endpoint.includes('/v2/adCampaigns')) return 'campaigns'
    if (endpoint.includes('/v2/adAnalytics')) return 'analytics'
    if (endpoint.includes('/v2/people')) return 'people'
    return 'other'
  }

  getMetrics(): LinkedInMetrics {
    return { ...this.metrics }
  }

  resetMetrics(): void {
    this.metrics = {
      totalRequests: 0,
      successfulRequests: 0,
      failedRequests: 0,
      rateLimitHits: 0,
      averageResponseTime: 0,
      requestsPerEndpoint: {},
      errorsPerEndpoint: {}
    }
  }
}
```

## Performance Optimization

### Connection Pooling
```typescript
class LinkedInConnectionPool {
  private pool: LinkedInApiClient[] = []
  private maxConnections = 10
  private availableConnections: LinkedInApiClient[] = []

  constructor(maxConnections: number = 10) {
    this.maxConnections = maxConnections
  }

  async getConnection(): Promise<LinkedInApiClient> {
    if (this.availableConnections.length > 0) {
      return this.availableConnections.pop()!
    }

    if (this.pool.length < this.maxConnections) {
      const connection = await this.createConnection()
      this.pool.push(connection)
      return connection
    }

    // Wait for available connection
    return new Promise((resolve) => {
      const checkAvailable = () => {
        if (this.availableConnections.length > 0) {
          resolve(this.availableConnections.pop()!)
        } else {
          setTimeout(checkAvailable, 100)
        }
      }
      checkAvailable()
    })
  }

  async releaseConnection(connection: LinkedInApiClient): Promise<void> {
    if (this.pool.includes(connection)) {
      this.availableConnections.push(connection)
    }
  }

  private async createConnection(): Promise<LinkedInApiClient> {
    // Create and authenticate new connection
    return new LinkedInApiClient()
  }

  async closeAll(): Promise<void> {
    await Promise.all(
      this.pool.map(connection => connection.disconnect())
    )
    this.pool = []
    this.availableConnections = []
  }
}
```

