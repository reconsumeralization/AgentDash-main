## Permission Request Patterns

### Minimal Scope Principle
Always request only the minimum permissions needed:

```typescript
// ❌ Bad - requesting too many permissions
const broadScopes = ['profile', 'email', 'w_member_social', 'rw_ads', 'r_sales_nav_analytics']

// ✅ Good - request only what's needed
const minimalScopes = ['profile', 'email'] // For user authentication
const marketingScopes = ['rw_ads', 'r_ads_reporting'] // For campaign management only
```

### Progressive Permission Requests
Request permissions incrementally based on user actions:

```typescript
class PermissionManager {
  private grantedScopes: Set<string> = new Set()

  async requestScope(scope: string): Promise<boolean> {
    if (this.grantedScopes.has(scope)) {
      return true
    }

    const authUrl = this.buildAuthUrl([scope])
    const success = await this.performOAuthFlow(authUrl)

    if (success) {
      this.grantedScopes.add(scope)
    }

    return success
  }

  async ensureScopes(requiredScopes: string[]): Promise<boolean> {
    const missingScopes = requiredScopes.filter(scope => !this.grantedScopes.has(scope))

    if (missingScopes.length === 0) {
      return true
    }

    return this.requestScope(missingScopes[0]) // Request incrementally
  }
}
```

## Scope Validation

### Runtime Scope Checking
Validate permissions before making API calls:

```typescript
class LinkedInApiClient {
  private availableScopes: Set<string>

  constructor(accessToken: string, scopes: string[]) {
    this.availableScopes = new Set(scopes)
  }

  private validateScope(requiredScope: string): void {
    if (!this.availableScopes.has(requiredScope)) {
      throw new Error(`Missing required scope: ${requiredScope}`)
    }
  }

  async getProfile(): Promise<UserProfile> {
    this.validateScope('profile')

    const response = await fetch('https://api.linkedin.com/v2/people/~', {
      headers: { 'Authorization': `Bearer ${accessToken}` }
    })

    return response.json()
  }

  async postShare(content: string): Promise<ShareResponse> {
    this.validateScope('w_member_social')

    const response = await fetch('https://api.linkedin.com/v2/shares', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${accessToken}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ content: { text: content } })
    })

    return response.json()
  }
}
```

## Business Line Integration Patterns

### Marketing API Integration
```typescript
class MarketingClient {
  async createCampaign(campaign: Campaign): Promise<CampaignResponse> {
    await this.ensureScopes(['rw_ads'])

    const response = await this.apiRequest('/v2/adCampaignsV2', {
      method: 'POST',
      body: JSON.stringify(campaign)
    })

    return response.json()
  }

  async getCampaignAnalytics(campaignId: string): Promise<AnalyticsData> {
    await this.ensureScopes(['r_ads_reporting'])

    return this.apiRequest(`/v2/adAnalytics?q=analytics&campaign=${campaignId}`)
      .then(res => res.json())
  }
}
```

### Sales Navigator Integration
```typescript
class SalesClient {
  async searchLeads(criteria: SearchCriteria): Promise<Lead[]> {
    await this.ensureScopes(['r_sales_nav_profiles'])

    const query = new URLSearchParams({
      keywords: criteria.keywords,
      companies: criteria.companyIds?.join(','),
      titles: criteria.titles?.join(',')
    })

    return this.apiRequest(`/v2/sales/leadSearch?q=search&${query}`)
      .then(res => res.json())
  }
}
```

## Error Handling for Permission Issues

### Permission Denied Errors
```typescript
const handleApiError = (error: any) => {
  if (error.status === 403) {
    if (error.message?.includes('scope')) {
      // Handle missing scope
      console.error('Missing required scope:', error.message)
      // Trigger re-authentication with additional scopes
      return requestAdditionalScopes()
    }
  }

  // Handle other errors
  throw error
}
```

