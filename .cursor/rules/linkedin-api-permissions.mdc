# LinkedIn API Permissions & Scopes

## Permission Categories

### Open Permissions (No Approval Required)

**Consumer Solutions:**
```typescript
// Basic profile and authentication
const OPEN_SCOPES = [
  'profile',           // Basic profile info (name, photo, headline)
  'email',            // Primary email address
  'w_member_social'   // Post, comment, like on behalf of member
] as const

// Usage in authentication
const authUrl = `https://www.linkedin.com/oauth/v2/authorization?` +
  `response_type=code&` +
  `client_id=${CLIENT_ID}&` +
  `scope=${encodeURIComponent(OPEN_SCOPES.join(' '))}`
```

### Marketing Permissions (Approval Required)

**Lead Generation & Advertising:**
```typescript
const MARKETING_SCOPES = [
  'r_marketing_leadgen_automation',  // Lead generation forms
  'rw_ads',                         // Campaign management
  'r_ads_reporting',                // Analytics and reporting
  'rw_organization_admin',          // Organization management
  'r_organization_social',          // Organization social actions
  'w_organization_social'           // Post on behalf of organization
] as const

// Campaign management example
interface Campaign {
  id: string
  name: string
  status: 'ACTIVE' | 'PAUSED' | 'ARCHIVED'
  objectiveType: string
  budget: {
    amount: number
    currencyCode: string
  }
}

// Create campaign
const createCampaign = async (campaign: Omit<Campaign, 'id'>) => {
  const response = await fetch('https://api.linkedin.com/v2/adCampaignsV2', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${accessToken}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify(campaign)
  })
  return response.json()
}
```

