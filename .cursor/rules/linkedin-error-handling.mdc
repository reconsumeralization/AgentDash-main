## Monitoring & Alerting

### API Health Monitoring
```typescript
class LinkedInApiMonitor {
  private healthMetrics = {
    totalRequests: 0,
    successfulRequests: 0,
    failedRequests: 0,
    rateLimitHits: 0,
    averageResponseTime: 0
  }

  async monitorRequest<T>(
    operation: string,
    request: () => Promise<T>
  ): Promise<T> {
    const startTime = Date.now()

    try {
      this.healthMetrics.totalRequests++
      const result = await request()
      this.healthMetrics.successfulRequests++

      const responseTime = Date.now() - startTime
      this.updateAverageResponseTime(responseTime)

      return result
    } catch (error) {
      this.healthMetrics.failedRequests++

      if (error instanceof LinkedInApiException && error.status === 429) {
        this.healthMetrics.rateLimitHits++
      }

      throw error
    }
  }

  private updateAverageResponseTime(responseTime: number) {
    const alpha = 0.1 // Smoothing factor
    this.healthMetrics.averageResponseTime =
      (1 - alpha) * this.healthMetrics.averageResponseTime + alpha * responseTime
  }

  getHealthReport(): HealthReport {
    return {
      uptime: this.calculateUptime(),
      errorRate: this.healthMetrics.failedRequests / this.healthMetrics.totalRequests,
      rateLimitRate: this.healthMetrics.rateLimitHits / this.healthMetrics.totalRequests,
      averageResponseTime: this.healthMetrics.averageResponseTime,
      status: this.determineHealthStatus()
    }
  }

  private calculateUptime(): number {
    // Implementation depends on your monitoring setup
    return 0.99 // Example: 99% uptime
  }

  private determineHealthStatus(): 'HEALTHY' | 'DEGRADED' | 'UNHEALTHY' {
    const errorRate = this.healthMetrics.failedRequests / this.healthMetrics.totalRequests

    if (errorRate > 0.5) return 'UNHEALTHY'
    if (errorRate > 0.1) return 'DEGRADED'
    return 'HEALTHY'
  }
}
```

## API Versioning & Breaking Changes

### Version Header Management
```typescript
class ApiVersionManager {
  private currentVersion = '2.0.0'
  private supportedVersions = ['1.0.0', '2.0.0']

  getVersionHeader(): string {
    return this.currentVersion
  }

  validateVersion(version: string): boolean {
    return this.supportedVersions.includes(version)
  }

  migrateData(oldVersion: string, newVersion: string, data: any): any {
    // Implement data migration logic
    if (oldVersion === '1.0.0' && newVersion === '2.0.0') {
      return this.migrateV1ToV2(data)
    }
    return data
  }

  private migrateV1ToV2(data: any): any {
    // Example migration logic
    return {
      ...data,
      version: '2.0.0',
      migratedAt: new Date().toISOString()
    }
  }
}
```

