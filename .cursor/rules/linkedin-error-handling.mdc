## Error Handling Patterns

### Comprehensive Error Handler
```typescript
class LinkedInApiErrorHandler {
  static async handleApiResponse<T>(response: Response): Promise<T> {
    if (!response.ok) {
      const errorData = await response.json().catch(() => ({}))
      throw new LinkedInApiException(response.status, errorData)
    }

    return response.json()
  }

  static isRetryableError(error: LinkedInApiException): boolean {
    const retryableStatuses = [429, 500, 502, 503, 504]
    return retryableStatuses.includes(error.status)
  }

  static getRetryDelay(error: LinkedInApiException): number {
    if (error.status === 429) {
      // Check for Retry-After header
      const retryAfter = error.response?.headers?.get('Retry-After')
      return retryAfter ? parseInt(retryAfter) * 1000 : 60000 // 1 minute default
    }

    // Exponential backoff for server errors
    return Math.min(1000 * Math.pow(2, error.retryCount || 0), 30000)
  }
}

class LinkedInApiException extends Error {
  constructor(
    public status: number,
    public response: any,
    public retryCount: number = 0
  ) {
    super(response?.message || `LinkedIn API error: ${status}`)
    this.name = 'LinkedInApiException'
  }
}
```

### Retry Logic with Exponential Backoff
```typescript
class RetryableLinkedInClient {
  private maxRetries = 3

  async makeRequest<T>(
    endpoint: string,
    options: RequestInit = {}
  ): Promise<T> {
    let lastError: LinkedInApiException | null = null

    for (let attempt = 0; attempt <= this.maxRetries; attempt++) {
      try {
        const response = await fetch(`https://api.linkedin.com/v2/${endpoint}`, {
          ...options,
          headers: {
            ...options.headers,
            'Authorization': `Bearer ${this.accessToken}`,
            'X-Restli-Protocol-Version': '2.0.0'
          }
        })

        return await LinkedInApiErrorHandler.handleApiResponse<T>(response)
      } catch (error) {
        if (error instanceof LinkedInApiException) {
          lastError = error

          if (!LinkedInApiErrorHandler.isRetryableError(error) || attempt === this.maxRetries) {
            throw error
          }

          const delay = LinkedInApiErrorHandler.getRetryDelay(error)
          await new Promise(resolve => setTimeout(resolve, delay))
        } else {
          throw error
        }
      }
    }

    throw lastError
  }
}
```

## Rate Limiting Best Practices

### Rate Limit Headers
LinkedIn provides rate limit information in response headers:

```typescript
interface RateLimitHeaders {
  'X-Restli-Protocol-Version': string
  'X-RateLimit-Limit': string        // Total requests allowed
  'X-RateLimit-Remaining': string    // Remaining requests
  'X-RateLimit-Reset': string        // Unix timestamp when limit resets
  'Retry-After'?: string            // Seconds to wait (when rate limited)
}

// Extract rate limit information
const extractRateLimitInfo = (headers: Headers): RateLimitInfo | null => {
  const limit = headers.get('X-RateLimit-Limit')
  const remaining = headers.get('X-RateLimit-Remaining')
  const reset = headers.get('X-RateLimit-Reset')

  if (!limit || !remaining || !reset) {
    return null
  }

  return {
    limit: parseInt(limit),
    remaining: parseInt(remaining),
    reset: parseInt(reset) * 1000, // Convert to milliseconds
    resetDate: new Date(parseInt(reset) * 1000)
  }
}
```

### Rate Limit Management
```typescript
class RateLimitManager {
  private requestQueue: Array<() => Promise<any>> = []
  private isProcessing = false
  private rateLimitInfo: RateLimitInfo | null = null

  async enqueueRequest<T>(request: () => Promise<T>): Promise<T> {
    return new Promise((resolve, reject) => {
      this.requestQueue.push(async () => {
        try {
          const result = await request()
          resolve(result)
        } catch (error) {
          reject(error)
        }
      })

      this.processQueue()
    })
  }

  private async processQueue() {
    if (this.isProcessing || this.requestQueue.length === 0) {
      return
    }

    this.isProcessing = true

    while (this.requestQueue.length > 0) {
      if (this.shouldWaitForRateLimit()) {
        await this.waitForRateLimitReset()
      }

      const request = this.requestQueue.shift()
      if (request) {
        await request()
      }
    }

    this.isProcessing = false
  }

  private shouldWaitForRateLimit(): boolean {
    if (!this.rateLimitInfo) return false
    return this.rateLimitInfo.remaining <= 10 // Keep some buffer
  }

  private async waitForRateLimitReset(): Promise<void> {
    if (!this.rateLimitInfo) return

    const now = Date.now()
    const waitTime = this.rateLimitInfo.reset - now

    if (waitTime > 0) {
      console.log(`Rate limited. Waiting ${waitTime}ms until reset.`)
      await new Promise(resolve => setTimeout(resolve, waitTime))
    }
  }

  updateRateLimitInfo(headers: Headers) {
    const info = extractRateLimitInfo(headers)
    if (info) {
      this.rateLimitInfo = info
    }
  }
}
```

## Compliance & Data Protection

### Data Retention & Deletion
```typescript
class ComplianceManager {
  // GDPR-compliant data deletion
  async deleteUserData(userId: string): Promise<void> {
    // Delete all user data from your systems
    await Promise.all([
      this.deleteUserProfile(userId),
      this.deleteUserPosts(userId),
      this.deleteUserConnections(userId),
      this.deleteAnalyticsData(userId)
    ])

    // Log deletion for compliance
    await this.logDeletion(userId, 'GDPR_REQUEST')
  }

  // CCPA compliance - right to know
  async exportUserData(userId: string): Promise<UserDataExport> {
    const userData = await this.collectAllUserData(userId)

    return {
      userId,
      exportDate: new Date(),
      data: userData,
      retention: '30_days' // As per LinkedIn policy
    }
  }

  // Audit logging
  private async logDeletion(userId: string, reason: string): Promise<void> {
    await this.auditLog({
      action: 'DATA_DELETION',
      userId,
      reason,
      timestamp: new Date(),
      compliance: 'GDPR'
    })
  }
}
```

