# LinkedIn Business Line Integration Patterns

## Marketing Solutions

### Campaign Management
```typescript
interface MarketingCampaign {
  id?: string
  name: string
  account: string // Organization URN
  campaignGroup: string // Campaign group URN
  status: 'ACTIVE' | 'PAUSED' | 'ARCHIVED' | 'DRAFT'
  objectiveType: 'BRAND_AWARENESS' | 'CONSIDERATION' | 'LEAD_GENERATION' | 'WEBSITE_VISITS'
  budget: {
    amount: number
    currencyCode: 'USD' | 'EUR' | 'GBP'
    type: 'DAILY' | 'LIFETIME'
  }
  targetAudience: {
    locations: string[] // Geographic targeting
    industries: string[] // Industry targeting
    jobTitles: string[] // Job title targeting
    seniorities: string[] // Seniority level targeting
  }
  creative: {
    headline: string
    description: string
    callToAction: string
    imageUrl?: string
  }
}

class MarketingCampaignManager {
  private accessToken: string
  private accountId: string

  constructor(accessToken: string, accountId: string) {
    this.accessToken = accessToken
    this.accountId = accountId
  }

  async createCampaign(campaign: Omit<MarketingCampaign, 'id'>): Promise<MarketingCampaign> {
    const response = await this.apiRequest('/v2/adCampaignsV2', {
      method: 'POST',
      body: JSON.stringify({
        account: `urn:li:sponsoredAccount:${this.accountId}`,
        campaignGroup: campaign.campaignGroup,
        name: campaign.name,
        status: campaign.status,
        objectiveType: campaign.objectiveType,
        budget: {
          amount: campaign.budget.amount,
          currencyCode: campaign.budget.currencyCode,
          type: campaign.budget.type
        }
      })
    })

    return response.json()
  }

  async getCampaignAnalytics(campaignId: string, dateRange: DateRange): Promise<CampaignAnalytics> {
    const pivot = 'CAMPAIGN'
    const timeGranularity = 'DAILY'
    const fields = [
      'impressions',
      'clicks',
      'costInLocalCurrency',
      'conversions',
      'externalWebsiteConversions'
    ].join(',')

    const queryParams = new URLSearchParams({
      q: 'analytics',
      pivot,
      timeGranularity,
      dateRange: `(start:(year:${dateRange.start.getFullYear()},month:${dateRange.start.getMonth() + 1},day:${dateRange.start.getDate()}),end:(year:${dateRange.end.getFullYear()},month:${dateRange.end.getMonth() + 1},day:${dateRange.end.getDate()}))`,
      campaigns: `(values:List(urn:li:sponsoredCampaign:${campaignId}))`,
      fields
    })

    const response = await this.apiRequest(`/v2/adAnalyticsV2?${queryParams}`)
    return response.json()
  }

  private async apiRequest(endpoint: string, options: RequestInit = {}): Promise<Response> {
    const response = await fetch(`https://api.linkedin.com${endpoint}`, {
      ...options,
      headers: {
        ...options.headers,
        'Authorization': `Bearer ${this.accessToken}`,
        'Content-Type': 'application/json',
        'X-Restli-Protocol-Version': '2.0.0'
      }
    })

    if (!response.ok) {
      throw new Error(`LinkedIn API error: ${response.status} ${response.statusText}`)
    }

    return response
  }
}
```

