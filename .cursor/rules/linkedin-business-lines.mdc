## Talent Solutions

### Job Posting & Management
```typescript
interface JobPosting {
  integrationContext: string // Your ATS integration context
  companyName: string
  jobTitle: string
  location: {
    country: string
    city?: string
    postalCode?: string
  }
  description: string
  employmentType: 'FULL_TIME' | 'PART_TIME' | 'CONTRACT' | 'TEMPORARY' | 'INTERN'
  experienceLevel: 'ENTRY_LEVEL' | 'MID_SENIOR' | 'SENIOR' | 'EXECUTIVE'
  industries: string[]
  jobFunctions: string[]
  compensation?: {
    baseSalary: {
      amount: number
      currency: string
      period: 'HOUR' | 'DAY' | 'WEEK' | 'MONTH' | 'YEAR'
    }
  }
  applyMethod: {
    companyApplyUrl?: string
    easyApplyUrl?: string
    email?: string
  }
}

class JobPostingManager {
  async createJob(job: Omit<JobPosting, 'id'>): Promise<JobPosting> {
    const response = await this.apiRequest('/v2/jobs', {
      method: 'POST',
      body: JSON.stringify(job)
    })

    return response.json()
  }

  async updateJob(jobId: string, updates: Partial<JobPosting>): Promise<JobPosting> {
    const response = await this.apiRequest(`/v2/jobs/${jobId}`, {
      method: 'PUT',
      body: JSON.stringify(updates)
    })

    return response.json()
  }

  async closeJob(jobId: string): Promise<void> {
    await this.apiRequest(`/v2/jobs/${jobId}`, {
      method: 'DELETE'
    })
  }

  async getJobApplications(jobId: string): Promise<JobApplication[]> {
    const response = await this.apiRequest(
      `/v2/jobApplications?q=job&job=urn:li:job:${jobId}`
    )

    return response.json()
  }
}
```

