## Sales Navigator (SNAP)

### Lead Search & Enrichment
```typescript
interface SalesLeadSearch {
  keywords?: string
  company?: string
  title?: string
  location?: string
  industry?: string
  seniority?: 'ENTRY_LEVEL' | 'SENIOR' | 'EXECUTIVE' | 'DIRECTOR' | 'VP'
  yearsOfExperience?: {
    min?: number
    max?: number
  }
  currentCompany?: string[]
  pastCompany?: string[]
  school?: string[]
  profileLanguage?: string[]
}

interface SalesLead {
  id: string
  firstName: string
  lastName: string
  headline: string
  location: string
  profileUrl: string
  company: {
    name: string
    industry: string
    size: string
  }
  seniority: string
  yearsOfExperience: number
  sharedConnections: number
  profilePicture?: string
}

class SalesNavigatorClient {
  async searchLeads(search: SalesLeadSearch): Promise<SalesLead[]> {
    const queryParams = new URLSearchParams()

    Object.entries(search).forEach(([key, value]) => {
      if (value !== undefined && value !== null) {
        if (Array.isArray(value)) {
          queryParams.set(key, value.join(','))
        } else if (typeof value === 'object') {
          queryParams.set(key, JSON.stringify(value))
        } else {
          queryParams.set(key, value.toString())
        }
      }
    })

    const response = await this.apiRequest(
      `/v2/sales/leadSearch?q=search&${queryParams}`
    )

    return response.json()
  }

  async getLeadDetails(leadId: string): Promise<DetailedLead> {
    const response = await this.apiRequest(`/v2/sales/leads/${leadId}`)
    return response.json()
  }

  async saveLeadToAccount(leadId: string, listId: string): Promise<void> {
    await this.apiRequest(`/v2/sales/leadLists/${listId}/leads`, {
      method: 'POST',
      body: JSON.stringify({
        lead: `urn:li:salesLead:${leadId}`
      })
    })
  }

  private async apiRequest(endpoint: string, options: RequestInit = {}): Promise<Response> {
    const response = await fetch(`https://api.linkedin.com${endpoint}`, {
      ...options,
      headers: {
        ...options.headers,
        'Authorization': `Bearer ${this.accessToken}`,
        'Content-Type': 'application/json'
      }
    })

    if (!response.ok) {
      throw new Error(`Sales Navigator API error: ${response.status} ${response.statusText}`)
    }

    return response
  }
}
```

